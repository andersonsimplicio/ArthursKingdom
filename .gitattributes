# =========================================================================
# Configuração de Quebra de Linha (Auto CRLF / LF)
# =========================================================================
# Trata todos os arquivos de texto como LF no repositório (padrão cruzado seguro)
* text=auto eol=lf

# =========================================================================
# Arquivos de Texto / Código do Unity (Forçar LF)
# =========================================================================
*.cs text diff=csharp eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.md text eol=lf

# =========================================================================
# Arquivos do Unity (Cenas, Prefabs, Configurações)
# Note: Funciona apenas se "Asset Serialization" estiver em "Force Text" no Unity
# =========================================================================
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.guiskin text eol=lf
*.flare text eol=lf
*.fontsettings text eol=lf

# =========================================================================
# Arquivos Binários (Desativar mesclagem e conversão de linha)
# =========================================================================
# Imagens e Texturas
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.psd binary
*.tiff binary
*.iff binary
*.bmp binary
*.exr binary

# Áudio e Vídeo
*.wav binary
*.mp3 binary
*.ogg binary
*.aif binary
*.aiff binary
*.mp4 binary
*.mov binary

# Modelos 3D
*.fbx binary
*.obj binary
*.blend binary
*.dae binary
*.3ds binary
*.dxf binary
*.max binary

# Fontes
*.ttf binary
*.otf binary

# Executáveis e Bibliotecas
*.dll binary
*.dylib binary
*.so binary
*.a binary
*.exe binary